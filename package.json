{
  "name": "tr8",
  "version": "1.0.0",
  "private": true,
  "description": "TR8: personal projects and tasks.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "tsc -p tsconfig.edge.json --noEmit",
    "typecheck:finance:test": "tsc -p tsconfig.finance-test.json --noEmit",
    "build:finance:test": "vite build --config scripts/finance-6b2/vite.config.ts && node scripts/finance-6b2/verify-build.mjs",
    "serve:finance:test": "node scripts/finance-6b2/serve.mjs",
    "build:finance:domain:test": "vite build --config scripts/finance-6b3/vite.config.ts && node scripts/finance-6b2/verify-build.mjs --finance-6b3",
    "serve:finance:domain:test": "node scripts/finance-6b2/serve.mjs --finance-6b3",
    "build:finance:ui:test": "vite build --config scripts/finance-6b4/vite.config.ts && node scripts/finance-6b2/verify-build.mjs --finance-6b4",
    "serve:finance:ui:test": "node scripts/finance-6b2/serve.mjs --finance-6b4",
    "test": "vitest run",
    "test:edge": "vitest run --config vitest.edge.config.ts",
    "test:database:static": "node supabase/tests/rename_static.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "libsodium-sumo": "0.8.4",
    "libsodium-wrappers-sumo": "0.8.4",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/blob": "2.4.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "15.15.0",
    "jsdom": "30.1.3",
    "lucide": "0.460.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.4",
    "vitest": "5.0.5"
  }
}
