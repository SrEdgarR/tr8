# Only public frontend configuration. Never add a service_role / sb_secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Financial MCP draft: disabled until review and explicit publication approval.
# This server-only gate does not grant any account or mailbox permissions.
TR8_MCP_FINANCE_REVIEW_ENABLED=false
# Independent legacy PAT catalog gate. Keep false for a finance-only OAuth rollout.
TR8_MCP_LEGACY_FINANCE_ENABLED=false
# Optional browser review panel; this is not an authorization boundary.
VITE_TR8_MCP_FINANCE_REVIEW_ENABLED=false

# OAuth is a separate, local-review gate. No clients or grants are seeded.
TR8_MCP_OAUTH_REVIEW_ENABLED=false
VITE_TR8_MCP_OAUTH_REVIEW_ENABLED=false
